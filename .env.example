# Usado somente ao compilar a interface para uma API hospedada separadamente.
# VITE_API_URL=https://seu-servidor.example/api

# Configuração do servidor Node.js. Nunca exponha o diretório do banco na web.
PORT=3001
BRAVUS_DB_PATH=.bravus/portal.sqlite
BRAVUS_ALLOWED_ORIGINS=https://luizesantos777.github.io
# BRAVUS_PUBLIC_URL=https://seu-portal.example

# Chave administrativa privada (32 a 256 caracteres); nunca use prefixo VITE_.
# Se omitida, o servidor gera uma chave em .bravus/admin.key, com permissão 600.
# BRAVUS_ADMIN_KEY=
# BRAVUS_ADMIN_KEY_FILE=.bravus/admin.key
