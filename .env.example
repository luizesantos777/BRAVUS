# Vercel: conecte um banco Turso ao projeto em Storage e configure estas três
# variáveis privadas em Production (e Preview, se for usar). Nunca use VITE_.
# TURSO_DATABASE_URL=libsql://NOME_DO_BANCO.turso.io
# TURSO_AUTH_TOKEN=
# BRAVUS_ADMIN_KEY=
# BRAVUS_ADMIN_KEY deve ter de 32 a 256 caracteres e permite entrar em /#/admin.
# Não coloque tokens reais neste arquivo, no Git ou no chat.

# Usado somente ao compilar a interface para uma API hospedada separadamente.
# VITE_API_URL=https://seu-servidor.example/api

# Configuração do servidor Node.js. Nunca exponha o diretório do banco na web.
PORT=3001
BRAVUS_DB_PATH=.bravus/portal.sqlite
BRAVUS_ALLOWED_ORIGINS=https://luizesantos777.github.io
# BRAVUS_PUBLIC_URL=https://seu-portal.example

# Chave administrativa privada (32 a 256 caracteres); nunca use prefixo VITE_.
# Se omitida, o servidor gera uma chave em .bravus/admin.key, com permissão 600.
# BRAVUS_ADMIN_KEY=
# BRAVUS_ADMIN_KEY_FILE=.bravus/admin.key

# Web Push: opcionais, somente no servidor. Se omitidas, o modo SQLite local
# preserva push-keys.json privado; no Turso/Vercel, gera e preserva as chaves no banco.
# Ao configurar, use um par VAPID válido e mantenha-o entre implantações.
# BRAVUS_PUSH_PUBLIC_KEY=
# BRAVUS_PUSH_PRIVATE_KEY=
# BRAVUS_PUSH_SUBJECT=https://seu-portal.example

# Backup na Vercel: conecte um Blob de acesso Private em Storage.
# O token privado é adicionado pela integração; nunca use prefixo VITE_.
# BLOB_READ_WRITE_TOKEN=
# Opcional: segredo aleatório com pelo menos 32 caracteres para o cron diário
# das 06:00 UTC / 03:00 de Brasília. Sem cron, copia no primeiro acesso diário.
# CRON_SECRET=
