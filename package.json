{
  "name": "bravus",
  "private": true,
  "version": "0.1.0",
  "description": "Portal do atendente BRAVUS: vendas, comiss\u00f5es, repasses e acesso por token individual.",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "dev:api": "node --env-file-if-exists=.env server/index.ts",
    "start": "node --env-file-if-exists=.env server/index.ts",
    "manage": "node --env-file-if-exists=.env server/manage.ts",
    "build": "tsc --noEmit && vite build && npm run build:api",
    "build:pages": "npm run build && node scripts/build-pages.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "npm run build:api && node --test tests/domain.test.ts tests/api.test.ts tests/cloud.test.ts",
    "test:e2e": "npm run build && playwright test",
    "build:api": "node scripts/build-api.mjs"
  },
  "dependencies": {
    "@libsql/client": "0.18.0",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/web-push": "3.6.4",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
