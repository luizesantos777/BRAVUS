{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    { "source": "/manifest.webmanifest", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] },
    { "source": "/admin.webmanifest", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] },
    { "source": "/notifications-worker.js", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] }
  ],
  "functions": { "api/index.mjs": { "maxDuration": 60 } },
  "crons": [{ "path": "/api/cron/backups", "schedule": "0 6 * * *" }],
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api?__bravus_path=:path*" },
    { "source": "/atendente/:token", "destination": "/index.html" },
    { "source": "/admin", "destination": "/index.html" }
  ]
}
